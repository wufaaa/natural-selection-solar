{
  "name": "natural-selection-solar",
  "version": "4.4.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Natural Selection Solar",
  "description": "《自然选择号：太阳系防线》— Three.js 3D Space Combat across the entire Solar System",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "desktop:dev": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --win dir",
    "desktop:portable": "npm run build && electron-builder --win portable",
    "desktop:build": "npm run build && electron-builder --win dir portable",
    "desktop:mac": "npm run build && electron-builder --mac dmg zip --arm64 --x64",
    "desktop:mac:arm64": "npm run build && electron-builder --mac dmg zip --arm64",
    "desktop:mac:x64": "npm run build && electron-builder --mac dmg zip --x64"
  },
  "build": {
    "appId": "com.solaris.naturalselection",
    "productName": "NaturalSelectionSolar",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        "dir",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "NaturalSelectionSolar-Portable-x64.exe"
    },
    "mac": {
      "category": "public.app-category.games",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "extendInfo": {
        "NSCameraUsageDescription": "自然选择号需要访问摄像头用于本地双手手势飞控（视频仅在本地实时处理，不上传或录制）。"
      },
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    }
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.3",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "vite": "^6.2.0"
  }
}
